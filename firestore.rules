    }
    match /{collection}/{id} {
      allow get: if permitted('viewSecurity') && collection in ['tool_usage', 'page_views', 'session_logs', 'error_logs'];
      allow list: if permitted('viewSecurity') && bounded() && collection in ['tool_usage', 'page_views', 'session_logs', 'error_logs'];
    }
    match /{document=**} { allow read, write: if false; }
  }
}
